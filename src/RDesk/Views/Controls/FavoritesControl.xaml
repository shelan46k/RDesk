<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RDesk.Views.Controls.FavoritesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RDesk.Views.Controls">

    <Border Style="{StaticResource CardStyle}">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" MinHeight="0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <FontIcon x:Name="HeaderGlyph" Glyph="&#xE734;" Style="{StaticResource CardIconStyle}" Foreground="#E0A100" />
                <TextBlock Grid.Column="1" Text="文件格子" Style="{StaticResource CardTitleStyle}" Margin="2,0,0,0" />
                <Button Grid.Column="2" x:Name="OptionsButton" Style="{StaticResource PillButtonStyle}"
                        Padding="8,4" Click="OptionsButton_Click" ToolTipService.ToolTip="檢視、排序、重新命名、刪除">
                    <FontIcon Glyph="&#xE712;" FontSize="12" />
                </Button>
                <Button Grid.Column="3" x:Name="DetachButton" Style="{StaticResource PillButtonStyle}"
                        Padding="8,4" Click="DetachButton_Click"
                        ToolTipService.ToolTip="把目前格子放到桌面上">
                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                </Button>
                <Button Grid.Column="4" x:Name="AddButton"
                        Style="{StaticResource PillButtonStyle}" Padding="10,4" Click="AddButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="添加" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" x:Name="FoldButton" Style="{StaticResource PillButtonStyle}" Padding="8,4"
                        Click="FoldButton_Click" ToolTipService.ToolTip="縮起這格">
                    <FontIcon x:Name="FoldGlyph" Glyph="&#xE70E;" FontSize="12" />
                </Button>
            </Grid>

            <TextBlock x:Name="FoldSummary" Grid.Row="1" Visibility="Collapsed"
                       FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="文件格子" />

            <Grid x:Name="CardBody" Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="6" MinHeight="0">
                <ComboBox x:Name="GroupCombo" HorizontalAlignment="Stretch" CornerRadius="10"
                          SelectionChanged="GroupCombo_SelectionChanged"
                          RightTapped="GroupCombo_RightTapped" />

                <TextBlock Grid.Row="1" x:Name="HintText" FontSize="11"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <local:FileBoxView Grid.Row="2" x:Name="Box" VerticalAlignment="Stretch" MinHeight="0" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
