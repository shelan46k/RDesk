<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RDesk.Views.Controls.FileBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RDesk.Views.Controls"
    AllowDrop="True">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*" RowSpacing="6" Background="Transparent">
        <ScrollViewer x:Name="ChipScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Visibility="Collapsed">
            <StackPanel x:Name="ChipHost" />
        </ScrollViewer>

        <Grid Grid.Row="1">
            <GridView x:Name="ItemsGrid"
                      Margin="-4,0,-4,0"
                      SelectionMode="Extended"
                      IsItemClickEnabled="False"
                      CanDragItems="True"
                      CanReorderItems="True"
                      AllowDrop="True"
                      DragItemsStarting="Items_DragItemsStarting"
                      DragItemsCompleted="Items_DragItemsCompleted">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                        <Setter Property="Margin" Value="1" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:FavoriteItemViewModel">
                        <Border Width="74" Height="84" Padding="4,7,4,4" CornerRadius="8"
                                Background="Transparent" Opacity="{x:Bind ItemOpacity}"
                                ToolTipService.ToolTip="{x:Bind Tooltip}">
                            <StackPanel Spacing="5">
                                <Image Width="36" Height="36" Source="{x:Bind Icon, Mode=OneWay}" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="11.5" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="14"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ListView x:Name="ItemsList"
                      Visibility="Collapsed"
                      Margin="-4,0,-4,0"
                      SelectionMode="Extended"
                      CanDragItems="True"
                      CanReorderItems="True"
                      AllowDrop="True"
                      DragItemsStarting="Items_DragItemsStarting"
                      DragItemsCompleted="Items_DragItemsCompleted">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="Margin" Value="2,1" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FavoriteItemViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Background="Transparent"
                              Opacity="{x:Bind ItemOpacity}" ToolTipService.ToolTip="{x:Bind Tooltip}">
                            <Image Width="18" Height="18" Source="{x:Bind Icon, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Details}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="{StaticResource PillBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16,10" Margin="0,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="{StaticResource AccentTextBrush}" />
                    <TextBlock x:Name="EmptyText" Text="可將文件 / 資料夾拖放到此處" FontSize="12"
                               TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" />
                </StackPanel>
            </Border>

            <Border x:Name="DropOverlay" Visibility="Collapsed" CornerRadius="12" IsHitTestVisible="False"
                    BorderThickness="2" BorderBrush="{StaticResource AccentTextBrush}"
                    Background="{StaticResource ItemHoverBrush}">
                <TextBlock x:Name="DropText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
            </Border>

            <Border x:Name="CopyOverlay" Visibility="Collapsed" CornerRadius="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="18,14" Spacing="8">
                    <TextBlock x:Name="CopyTitle" Text="正在複製…" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <ProgressBar x:Name="CopyProgress" Minimum="0" Maximum="1" Value="0" Height="8"
                                 CornerRadius="4" Foreground="{StaticResource AccentFillBrush}" />
                    <TextBlock x:Name="CopyDetail" FontSize="11" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <Button x:Name="CopyCancelButton" Content="取消" HorizontalAlignment="Center"
                            Style="{StaticResource PillButtonStyle}" Padding="14,4"
                            Click="CopyCancel_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
