<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RDesk.Views.Controls.MusicControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}" Padding="14,12">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                <FontIcon Glyph="&#xE8D6;" Style="{StaticResource CardIconStyle}" Foreground="#EC4899" />
                <TextBlock Grid.Column="1" Text="音樂" Style="{StaticResource CardTitleStyle}" Margin="2,0,0,0" />
                <Button Grid.Column="2" Style="{StaticResource PillButtonStyle}" Padding="8,4"
                        Click="Folder_Click" ToolTipService.ToolTip="選擇要播放的資料夾">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                        <TextBlock Text="資料夾" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource PillButtonStyle}" Padding="8,4"
                        Click="AddPlaylist_Click" ToolTipService.ToolTip="新增播放清單">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="清單" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox x:Name="PlaylistCombo" HorizontalAlignment="Stretch" CornerRadius="10"
                          SelectionChanged="PlaylistCombo_SelectionChanged" />
                <Button Grid.Column="1" x:Name="DeletePlaylistButton" Style="{StaticResource PillButtonStyle}"
                        Padding="8,4" Click="DeletePlaylist_Click" ToolTipService.ToolTip="刪除這個播放清單">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                </Button>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border x:Name="VizHost" Width="56" Height="56" CornerRadius="12"
                        Background="{StaticResource PillBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <Canvas x:Name="VizCanvas" Width="56" Height="56" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="還沒有音樂" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock x:Name="ArtistText" Text="先選一個資料夾，或建立自己的播放清單" FontSize="11"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                        <ProgressBar x:Name="Progress" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0"
                                     CornerRadius="2" Foreground="{StaticResource AccentTextBrush}"
                                     PointerPressed="Progress_PointerPressed" />
                        <TextBlock Grid.Column="1" x:Name="TimeText" FontSize="10"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="PrevButton" Style="{StaticResource IconButtonStyle}" Click="Prev_Click"
                            ToolTipService.ToolTip="上一首">
                        <FontIcon Glyph="&#xE892;" FontSize="12" />
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource IconButtonStyle}" Click="Play_Click"
                            ToolTipService.ToolTip="播放 / 暫停">
                        <FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="14"
                                  Foreground="{StaticResource AccentTextBrush}" />
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource IconButtonStyle}" Click="Next_Click"
                            ToolTipService.ToolTip="下一首">
                        <FontIcon Glyph="&#xE893;" FontSize="12" />
                    </Button>
                    <Button x:Name="ShuffleButton" Style="{StaticResource IconButtonStyle}" Click="Shuffle_Click"
                            ToolTipService.ToolTip="隨機重排清單">
                        <FontIcon Glyph="&#xE8B1;" FontSize="12" />
                    </Button>
                    <Button x:Name="RepeatButton" Style="{StaticResource IconButtonStyle}" Click="Repeat_Click">
                        <FontIcon x:Name="RepeatGlyph" Glyph="&#xE8EE;" FontSize="12" />
                    </Button>
                </StackPanel>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80"
                        VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"
                        ToolTipService.ToolTip="音量" />
                <FontIcon Grid.Column="2" Glyph="&#xE767;" FontSize="12" VerticalAlignment="Center"
                          Foreground="{StaticResource SecondaryTextBrush}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <TextBlock x:Name="ListHint" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="ExpandListButton" Style="{StaticResource PillButtonStyle}"
                        Padding="8,4" Click="ExpandList_Click" ToolTipService.ToolTip="用較大的視窗編輯清單，可多選拖曳">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="11" />
                        <TextBlock Text="展開" VerticalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" x:Name="AddFilesButton" Style="{StaticResource PillButtonStyle}"
                        Padding="8,4" Click="AddFiles_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                        <TextBlock Text="加入歌曲" VerticalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
            </Grid>

            <ListView x:Name="TrackList" MaxHeight="168" SelectionMode="Single"
                      IsItemClickEnabled="True" ItemClick="TrackList_ItemClick"
                      RightTapped="TrackList_RightTapped"
                      CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                      DragItemsStarting="TrackList_DragItemsStarting"
                      DragItemsCompleted="TrackList_DragItemsCompleted">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE76F;" FontSize="10" Opacity="0.4"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource SecondaryTextBrush}"
                                      ToolTipService.ToolTip="拖曳調整順序" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Border>
</UserControl>
