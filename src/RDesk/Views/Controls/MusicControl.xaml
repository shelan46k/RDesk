<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RDesk.Views.Controls.MusicControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}" Padding="14,12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource LogoGradientBrush}">
                <Grid>
                    <FontIcon x:Name="CoverGlyph" Glyph="&#xE8D6;" FontSize="22" Foreground="White" />
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="沒有正在播放的媒體" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock x:Name="ArtistText" Text="在 Spotify、瀏覽器或媒體播放器播放後會顯示在這裡" FontSize="11"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                    <ProgressBar x:Name="Progress" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0"
                                 CornerRadius="2" Foreground="{StaticResource AccentTextBrush}" />
                    <TextBlock Grid.Column="1" x:Name="TimeText" FontSize="10"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="-4,0,0,0">
                    <Button x:Name="PrevButton" Style="{StaticResource IconButtonStyle}" Click="Prev_Click" ToolTipService.ToolTip="上一首">
                        <FontIcon Glyph="&#xE892;" FontSize="12" />
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource IconButtonStyle}" Click="Play_Click" ToolTipService.ToolTip="播放 / 暫停">
                        <FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="14" Foreground="{StaticResource AccentTextBrush}" />
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource IconButtonStyle}" Click="Next_Click" ToolTipService.ToolTip="下一首">
                        <FontIcon Glyph="&#xE893;" FontSize="12" />
                    </Button>
                    <TextBlock x:Name="SourceText" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="150"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
