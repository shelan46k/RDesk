<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RDesk.Views.Controls.RecentFilesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" MinHeight="0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <FontIcon Glyph="&#xE81C;" Style="{StaticResource CardIconStyle}" />
                <TextBlock Grid.Column="1" Text="最近打開的文件" Style="{StaticResource CardTitleStyle}" />
                <Button Grid.Column="2" x:Name="RefreshButton"
                        Style="{StaticResource PillButtonStyle}" Padding="10,4" Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="刷新" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" x:Name="FoldButton" Style="{StaticResource PillButtonStyle}" Padding="8,4"
                        Click="FoldButton_Click" ToolTipService.ToolTip="縮起這格">
                    <FontIcon x:Name="FoldGlyph" Glyph="&#xE70E;" FontSize="12" />
                </Button>
            </Grid>

            <TextBlock x:Name="FoldSummary" Grid.Row="1" Visibility="Collapsed"
                       FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="最近文件" />

            <Grid x:Name="CardBody" Grid.Row="2" RowDefinitions="*,Auto" RowSpacing="8" MinHeight="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-6,0,-6,0">
                    <VariableSizedWrapGrid x:Name="FilesHost" Orientation="Horizontal"
                                           MaximumRowsOrColumns="2" ItemWidth="160" ItemHeight="48" />
                </ScrollViewer>

                <TextBlock Grid.Row="1" x:Name="HintText" Style="{StaticResource CaptionTextStyle}"
                           Text="雙擊打開；右鍵可收藏置頂 / 加到常用 / 定位文件" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
