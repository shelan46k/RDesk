<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RDesk.Views.Controls.SystemNetworkControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="PartsGrid" ColumnDefinitions="*,10,*">
        <Border x:Name="SystemPart" Style="{StaticResource CardStyle}" Padding="12,12">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="#7C5CFF" />
                    <TextBlock Text="系統狀態" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                </StackPanel>
                <TextBlock x:Name="CpuRamText" Text="CPU --% · 記憶體 --%" FontSize="13" FontWeight="Bold"
                           TextWrapping="WrapWholeWords"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <ProgressBar x:Name="RamBar" Maximum="100" Height="3" CornerRadius="2" Margin="0,2" />
                <TextBlock x:Name="DiskUptimeText" Text="系統碟 --% · 運行 --"
                           TextWrapping="WrapWholeWords"
                           FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <Border x:Name="NetworkPart" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12,12">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="#0EA5E9" />
                    <TextBlock Grid.Column="1" Text="網路狀態" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Grid.Column="2" x:Name="ConnText" FontSize="11" />
                </Grid>
                <TextBlock x:Name="SpeedText" Text="↓ -- · ↑ --" FontSize="13" FontWeight="Bold"
                           TextWrapping="WrapWholeWords"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock x:Name="NicText" Text="--" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
