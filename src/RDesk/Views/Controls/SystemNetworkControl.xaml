<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RDesk.Views.Controls.SystemNetworkControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}" Padding="14,12">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" MinHeight="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <FontIcon Glyph="&#xE9D9;" Style="{StaticResource CardIconStyle}" Foreground="#7C5CFF" />
                <TextBlock Grid.Column="1" Text="系統狀態" Style="{StaticResource CardTitleStyle}" Margin="2,0,0,0" />
                <Button Grid.Column="2" x:Name="FoldButton" Style="{StaticResource PillButtonStyle}" Padding="8,4"
                        Click="FoldButton_Click" ToolTipService.ToolTip="縮起這格">
                    <FontIcon x:Name="FoldGlyph" Glyph="&#xE70E;" FontSize="12" />
                </Button>
            </Grid>

            <!-- Collapsed: three equal chips, label on top, two numbers below -->
            <Grid x:Name="FoldSummary" Grid.Row="1" Visibility="Collapsed" ColumnSpacing="6" MinHeight="0">
                <Border x:Name="FoldSystem" Background="{StaticResource PillBackgroundBrush}"
                        CornerRadius="8" Padding="7,4">
                    <StackPanel Spacing="1">
                        <TextBlock Text="系統" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="FoldCpu" Text="CPU --%" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock x:Name="FoldRam" Text="記憶體 --%" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="FoldNetwork" Background="{StaticResource PillBackgroundBrush}"
                        CornerRadius="8" Padding="7,4">
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="FoldConn" Text="網路" FontSize="10"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="FoldDown" Text="↓ --" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock x:Name="FoldUp" Text="↑ --" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="FoldDisk" Background="{StaticResource PillBackgroundBrush}"
                        CornerRadius="8" Padding="7,4">
                    <StackPanel Spacing="1">
                        <TextBlock Text="硬碟" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="FoldDiskRead" Text="讀 --" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock x:Name="FoldDiskWrite" Text="寫 --" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Expanded: full-width rows, label | value | bar -->
            <StackPanel x:Name="CardBody" Grid.Row="2" Spacing="12" MinHeight="0">
                <StackPanel x:Name="SystemPart" Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="#7C5CFF" />
                            <TextBlock Text="系統" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="UptimeText" Text="運行 --" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="52,80,*" ColumnSpacing="10">
                        <TextBlock Text="CPU" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="CpuText" Grid.Column="1" Text="--%" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <Grid Grid.Column="2" Height="6" VerticalAlignment="Center">
                            <Border CornerRadius="3" Background="{StaticResource CardBorderBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CpuUsed" Width="1*" />
                                    <ColumnDefinition x:Name="CpuFree" Width="99*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CpuFill" CornerRadius="3"
                                        Background="{StaticResource AccentFillBrush}" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid ColumnDefinitions="52,80,*" ColumnSpacing="10">
                        <TextBlock Text="記憶體" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="RamText" Grid.Column="1" Text="--%" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <Grid Grid.Column="2" Height="6" VerticalAlignment="Center">
                            <Border CornerRadius="3" Background="{StaticResource CardBorderBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="RamUsed" Width="1*" />
                                    <ColumnDefinition x:Name="RamFree" Width="99*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="RamFill" CornerRadius="3"
                                        Background="{StaticResource AccentFillBrush}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="NetworkPart" Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="#0EA5E9" />
                            <TextBlock Text="網路" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="ConnText" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="52,80,*" ColumnSpacing="10">
                        <TextBlock Text="下載" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="DownText" Grid.Column="1" Text="--" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="52,80,*" ColumnSpacing="10">
                        <TextBlock Text="上傳" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="UpText" Grid.Column="1" Text="--" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </Grid>
                    <TextBlock x:Name="NicText" Text="--" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <StackPanel x:Name="DiskPart" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="#F97316" />
                        <TextBlock Text="硬碟" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="52,80,*" ColumnSpacing="10">
                        <TextBlock Text="讀取" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="DiskReadText" Grid.Column="1" Text="--" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="52,80,*" ColumnSpacing="10">
                        <TextBlock Text="寫入" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="DiskWriteText" Grid.Column="1" Text="--" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </Grid>
                    <StackPanel x:Name="DiskHost" Spacing="6" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
