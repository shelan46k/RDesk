<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RDesk.Views.Controls.TodoNotesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" MinHeight="0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <ContentControl x:Name="ModeHost" HorizontalContentAlignment="Left" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="ActionButton" Style="{StaticResource PillButtonStyle}"
                        Click="ActionButton_Click" />
                <Button Grid.Column="2" x:Name="FoldButton" Style="{StaticResource PillButtonStyle}" Padding="8,4"
                        Click="FoldButton_Click" ToolTipService.ToolTip="縮起這格">
                    <FontIcon x:Name="FoldGlyph" Glyph="&#xE70E;" FontSize="12" />
                </Button>
            </Grid>

            <TextBlock x:Name="FoldSummary" Grid.Row="1" Visibility="Collapsed"
                       FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="待辦" />

            <!-- Reminder banner (DeskBox: complete or snooze straight from the reminder) -->
            <Border Grid.Row="2" x:Name="ReminderBanner" Visibility="Collapsed" CornerRadius="12" Padding="12,8"
                    Background="{StaticResource PillBackgroundBrush}"
                    BorderBrush="{StaticResource WarningTextBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEA8F;" FontSize="13" Foreground="{StaticResource WarningTextBrush}" />
                        <TextBlock x:Name="ReminderText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                   MaxWidth="280" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Style="{StaticResource PillButtonStyle}" Padding="8,2" MinHeight="24" Click="ReminderDone_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" />
                                <TextBlock Text="完成" VerticalAlignment="Center" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button Content="10 分" Tag="10" Style="{StaticResource PillButtonStyle}" Padding="8,2" MinHeight="24" Click="ReminderSnooze_Click" />
                        <Button Content="1 小時" Tag="60" Style="{StaticResource PillButtonStyle}" Padding="8,2" MinHeight="24" Click="ReminderSnooze_Click" />
                        <Button Content="明天 9 點" Tag="tomorrow" Style="{StaticResource PillButtonStyle}" Padding="8,2" MinHeight="24" Click="ReminderSnooze_Click" />
                        <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="ReminderDismiss_Click"
                                ToolTipService.ToolTip="關閉">
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="CardBody" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" MinHeight="0">
            <Grid>
                <!-- 待辦 -->
                <StackPanel x:Name="TodoPanel" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox x:Name="TodoInput" PlaceholderText="新增待辦，按 Enter 送出..."
                                 CornerRadius="10" KeyDown="TodoInput_KeyDown" />
                        <Button Grid.Column="1" Style="{StaticResource PillButtonStyle}" Padding="8,4"
                                Click="TodoDetail_Click" ToolTipService.ToolTip="新增並設定日期、提醒、重複、附件">
                            <FontIcon Glyph="&#xE787;" FontSize="12" />
                        </Button>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TodoHost" Spacing="1" />
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" Text="今天沒有待辦，好好享受 ☕" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,4"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="StatsText" FontSize="11" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               ToolTipService.ToolTip="雙擊編輯，右鍵看更多" />
                </StackPanel>

                <!-- 隨記 -->
                <StackPanel x:Name="NotePanel" Spacing="6" Visibility="Collapsed" AllowDrop="True">
                    <TextBox x:Name="NoteInput" AcceptsReturn="True" TextWrapping="Wrap" CornerRadius="10"
                             MinHeight="60" MaxHeight="120"
                             PlaceholderText="記下文字、連結… Ctrl+Enter 儲存（可拖入檔案當附件）"
                             KeyDown="NoteInput_KeyDown" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="NoteStatsText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource PillButtonStyle}" Padding="10,4" Click="NoteSave_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                <TextBlock Text="儲存" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NoteHost" Spacing="6" />
                    </ScrollViewer>
                    <TextBlock x:Name="NoteEmptyText" Text="還沒有隨記" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- 剪貼簿 -->
                <StackPanel x:Name="ClipPanel" Spacing="6" Visibility="Collapsed">
                    <TextBlock x:Name="ClipStatusText" Style="{StaticResource CaptionTextStyle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ClipHost" Spacing="4" />
                    </ScrollViewer>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
