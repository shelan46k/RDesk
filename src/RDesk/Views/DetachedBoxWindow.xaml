<?xml version="1.0" encoding="utf-8"?>
<windowex:WindowEx
    x:Class="RDesk.Views.DetachedBoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:windowex="using:WinUIEx"
    xmlns:controls="using:RDesk.Views.Controls"
    Title="RDesk 桌面格"
    Width="320"
    Height="260"
    IsResizable="False"
    IsMaximizable="False"
    IsMinimizable="False">

    <windowex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </windowex:WindowEx.SystemBackdrop>

    <!-- No XAML corner radius / border: DWM clips the window to anti-aliased rounded corners. -->
    <Grid x:Name="RootGrid" Background="{StaticResource BoxBackgroundBrush}" Padding="10,6,10,10"
          RowDefinitions="Auto,*" RowSpacing="6">
        <Grid x:Name="TitleBar" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="2"
              Background="Transparent" Height="28"
              PointerPressed="TitleBar_PointerPressed"
              PointerMoved="TitleBar_PointerMoved"
              PointerReleased="TitleBar_PointerReleased"
              PointerCaptureLost="TitleBar_PointerCaptureLost"
              PointerCanceled="TitleBar_PointerCaptureLost"
              DoubleTapped="TitleBar_DoubleTapped">
            <FontIcon x:Name="FolderGlyph" Glyph="&#xE8B7;" FontSize="14" Margin="2,0,6,0"
                      Foreground="#E0A100" />
            <TextBlock Grid.Column="1" x:Name="TitleText" FontWeight="Bold" FontSize="13"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource PrimaryTextBrush}" />
            <Button Grid.Column="2" x:Name="MenuButton" Style="{StaticResource IconButtonStyle}"
                    Width="26" Height="26" Click="MenuButton_Click" ToolTipService.ToolTip="檢視、排序、叠放">
                <FontIcon Glyph="&#xE712;" FontSize="11" />
            </Button>
            <Button Grid.Column="3" x:Name="CollapseButton" Style="{StaticResource IconButtonStyle}"
                    Width="26" Height="26" Click="CollapseButton_Click"
                    ToolTipService.ToolTip="收折成膠囊（也可雙擊標題）">
                <FontIcon x:Name="CollapseGlyph" Glyph="&#xE921;" FontSize="11" />
            </Button>
            <Button Grid.Column="4" x:Name="CloseButton" Style="{StaticResource IconButtonStyle}"
                    Width="26" Height="26" Click="CloseButton_Click"
                    ToolTipService.ToolTip="收回到主面板">
                <FontIcon Glyph="&#xE711;" FontSize="11" />
            </Button>
        </Grid>

        <controls:FileBoxView Grid.Row="1" x:Name="Box" />
        <controls:ResizeGrip Grid.Row="1" x:Name="Grip" Margin="0,0,-8,-8"
                             PointerPressed="Grip_PointerPressed"
                             PointerMoved="Grip_PointerMoved"
                             PointerReleased="Grip_PointerReleased"
                             PointerCaptureLost="Grip_PointerCaptureLost"
                             PointerCanceled="Grip_PointerCaptureLost" />
    </Grid>
</windowex:WindowEx>
