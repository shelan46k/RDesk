<?xml version="1.0" encoding="utf-8"?>
<windowex:WindowEx
    x:Class="RDesk.Views.OrganizeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:windowex="using:WinUIEx"
    Title="RDesk 一鍵整理桌面"
    Width="640"
    Height="720"
    MinWidth="480"
    MinHeight="480">

    <windowex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </windowex:WindowEx.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="28,22,28,6">
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource LogoGradientBrush}">
                <FontIcon Glyph="&#xE8CB;" FontSize="16" Foreground="White" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="一鍵整理桌面" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource DialogPrimaryTextBrush}" />
                <TextBlock Text="先檢查移動計畫，確認後才會移動；整理後可以復原" FontSize="12"
                           Foreground="{StaticResource DialogSecondaryTextBrush}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="28,8,28,8" Style="{StaticResource SettingRowStyle}" MinHeight="0">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource DialogPrimaryTextBrush}" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PlanHost" Spacing="4" Margin="28,0,28,12" />
        </ScrollViewer>

        <Grid Grid.Row="3" Padding="28,12,28,20" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="RescanButton" Content="重新掃描" Click="Rescan_Click" />
            <Button Grid.Column="1" x:Name="UndoButton" Content="復原上次整理" Click="Undo_Click" />
            <Button Grid.Column="3" x:Name="ExecuteButton" Content="執行整理" Style="{StaticResource AccentButtonStyle}"
                    MinWidth="120" Click="Execute_Click" />
        </Grid>
    </Grid>
</windowex:WindowEx>
