<?xml version="1.0" encoding="utf-8"?>
<windowex:WindowEx
    x:Class="RDesk.Views.PlaylistWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:windowex="using:WinUIEx"
    Title="RDesk 播放清單"
    Width="560"
    Height="720"
    MinWidth="440"
    MinHeight="420">

    <windowex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </windowex:WindowEx.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto" Padding="22,18,22,16" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*">
            <Image Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center"
                   Source="ms-appx:///Assets/rdesk.png" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="播放清單" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource DialogPrimaryTextBrush}" />
                <TextBlock x:Name="SubtitleText" FontSize="12"
                           Foreground="{StaticResource DialogSecondaryTextBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="FilterBox" PlaceholderText="搜尋歌曲名稱…"
                     CornerRadius="10" TextChanged="FilterBox_TextChanged" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="PlaySelectedButton" Style="{StaticResource PillButtonStyle}" Padding="10,4"
                        Click="PlaySelected_Click" ToolTipService.ToolTip="播放選取的第一首">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                        <TextBlock Text="播放" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="MoveUp_Click" ToolTipService.ToolTip="上移選取">
                    <FontIcon Glyph="&#xE74A;" FontSize="12" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="MoveDown_Click" ToolTipService.ToolTip="下移選取">
                    <FontIcon Glyph="&#xE74B;" FontSize="12" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="MoveTop_Click" ToolTipService.ToolTip="移到最前">
                    <FontIcon Glyph="&#xE898;" FontSize="12" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="MoveBottom_Click" ToolTipService.ToolTip="移到最後">
                    <FontIcon Glyph="&#xE896;" FontSize="12" />
                </Button>
                <Button x:Name="RemoveButton" Style="{StaticResource IconButtonStyle}" Click="Remove_Click"
                        ToolTipService.ToolTip="從清單移除選取" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <ListView x:Name="TrackList" Grid.Row="2"
                  SelectionMode="Extended"
                  CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                  SelectionChanged="TrackList_SelectionChanged"
                  DragItemsCompleted="TrackList_DragItemsCompleted"
                  DoubleTapped="TrackList_DoubleTapped"
                  RightTapped="TrackList_RightTapped"
                  KeyDown="TrackList_KeyDown">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="10,4" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                        <FontIcon Glyph="{Binding PlayingGlyph}" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{StaticResource AccentTextBrush}" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="{Binding NumberText}" FontSize="11" Width="36"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource DialogSecondaryTextBrush}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource DialogPrimaryTextBrush}" />
                            <TextBlock Text="{Binding Folder}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource DialogSecondaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding PlayingLabel}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentTextBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="HintText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                       Text="Ctrl 點選多首 · Shift 連選 · 拖曳調整順序 · 連按兩下播放" />
            <TextBlock Grid.Column="1" x:Name="CountText" FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource DialogSecondaryTextBrush}" />
        </Grid>
    </Grid>
</windowex:WindowEx>
