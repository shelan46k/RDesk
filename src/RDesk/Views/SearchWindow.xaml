<?xml version="1.0" encoding="utf-8"?>
<windowex:WindowEx
    x:Class="RDesk.Views.SearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:windowex="using:WinUIEx"
    xmlns:services="using:RDesk.Services"
    Title="RDesk 搜尋"
    Width="660"
    Height="500"
    IsResizable="False"
    IsMaximizable="False"
    IsMinimizable="False">

    <windowex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </windowex:WindowEx.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{StaticResource PanelBackgroundBrush}" Padding="16,14,16,12"
          RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
              Background="{StaticResource PillBackgroundBrush}" CornerRadius="10" Padding="14,4,6,4"
              BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{StaticResource AccentTextBrush}" />
            <TextBox Grid.Column="1" x:Name="QueryBox" PlaceholderText="搜尋應用、檔案、待辦與隨記…"
                     FontSize="16" BorderThickness="0" Background="Transparent"
                     TextChanged="QueryBox_TextChanged" KeyDown="QueryBox_KeyDown" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <ContentControl x:Name="FilterHost" />
            <TextBlock Grid.Column="1" x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
        </Grid>

        <ListView Grid.Row="2" x:Name="ResultsList" SelectionMode="Single" IsItemClickEnabled="True"
                  ItemClick="ResultsList_ItemClick" RightTapped="ResultsList_RightTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="MinHeight" Value="44" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:SearchResult">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="2,4">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{StaticResource AccentTextBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="8" Padding="8,2" VerticalAlignment="Center"
                                Background="{StaticResource SegmentTrackBrush}">
                            <TextBlock Text="{x:Bind KindLabel}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" x:Name="IdlePanel" Spacing="8" Margin="4,4,4,0">
            <TextBlock Text="最近搜尋" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
            <VariableSizedWrapGrid x:Name="HistoryHost" Orientation="Horizontal" ItemHeight="34" />
            <TextBlock x:Name="IdleHint" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>

        <TextBlock Grid.Row="3" Style="{StaticResource CaptionTextStyle}"
                   Text="Enter 開啟 · Ctrl+Enter 開啟所在位置 · Ctrl+Shift+C 複製路徑 · ↑↓ 選擇 · Esc 關閉" />
    </Grid>
</windowex:WindowEx>
