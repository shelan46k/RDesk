<?xml version="1.0" encoding="utf-8"?>
<windowex:WindowEx
    x:Class="RDesk.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:windowex="using:WinUIEx"
    Title="RDesk 偏好設定"
    Width="960"
    Height="720"
    MinWidth="840"
    MinHeight="520">

    <windowex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </windowex:WindowEx.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="28,22,28,10">
            <Image Width="36" Height="36" Stretch="Uniform"
                   Source="ms-appx:///Assets/rdesk.png" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="偏好設定" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource DialogPrimaryTextBrush}" />
                <TextBlock Text="變更會立即套用並自動儲存" FontSize="12"
                           Foreground="{StaticResource DialogSecondaryTextBrush}" />
            </StackPanel>
        </StackPanel>

        <NavigationView
            x:Name="SettingsNav"
            Grid.Row="1"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            AlwaysShowHeader="False"
            PaneDisplayMode="Left"
            OpenPaneLength="168"
            IsPaneOpen="True"
            Background="Transparent"
            SelectionChanged="SettingsNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavGeneral" Content="一般" Tag="general" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外觀" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="區塊" Tag="blocks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="桌面" Tag="desktop">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="功能" Tag="features">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="備份" Tag="backup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Margin="8,4,20,8">
                <!-- 一般：顯示器、隱藏、系統 -->
                <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Padding="0,0,8,8">
                        <TextBlock Text="顯示器與位置" Style="{StaticResource SettingSectionStyle}" />
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="#0EA5E9" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="停靠的顯示器" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="多螢幕時可指定側邊欄出現在哪一台" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ComboBox x:Name="MonitorCombo" MinWidth="180" SelectionChanged="MonitorCombo_SelectionChanged" />
                                    <Button Click="RefreshMonitors_Click" ToolTipService.ToolTip="重新偵測螢幕">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE89F;" FontSize="18" Foreground="#6366F1" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="停靠方向" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="貼齊螢幕右側或左側" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="DockCombo" MinWidth="140" VerticalAlignment="Center"
                                          SelectionChanged="DockCombo_SelectionChanged">
                                    <ComboBoxItem Content="靠右" Tag="Right" />
                                    <ComboBoxItem Content="靠左" Tag="Left" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE740;" FontSize="18" Foreground="#14B8A6" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="側邊欄寬度" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="WidthValueText" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Slider Grid.Column="2" x:Name="WidthSlider" Width="200" VerticalAlignment="Center"
                                        Minimum="340" Maximum="460" StepFrequency="10"
                                        ValueChanged="WidthSlider_ValueChanged" />
                            </Grid>
                        </Border>

                        <TextBlock Text="隱藏與喚出" Style="{StaticResource SettingSectionStyle}" />
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE765;" FontSize="18" Foreground="#8B5CF6" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="全域快捷鍵" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="在任何程式中按下即可切換展開 / 隱藏" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" x:Name="HotkeyToggle" MinWidth="0" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="HotkeyToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE92E;" FontSize="18" Foreground="#8B5CF6" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="快捷鍵組合" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <TextBox Grid.Column="2" x:Name="HotkeyBox" Width="140" VerticalAlignment="Center"
                                         PlaceholderText="F7" LostFocus="HotkeyBox_LostFocus" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{StaticResource DialogSecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionStyle}"
                                           Text="隱藏後桌面不留任何物件，只保留系統匣圖示。點系統匣圖示或按快捷鍵切換展開 / 隱藏；右鍵系統匣圖示可開啟選單。" />
                            </Grid>
                        </Border>

                        <TextBlock Text="系統" Style="{StaticResource SettingSectionStyle}" />
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE718;" FontSize="18" Foreground="#EF4444" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="釘選在桌面層" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="按 Win+D 顯示桌面時，側邊欄與桌面格不會被縮小" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" x:Name="PinToggle" MinWidth="0" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="PinToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE7E8;" FontSize="18" Foreground="#22C55E" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="開機時自動啟動" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="登入 Windows 後自動在背景執行" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" x:Name="StartupToggle" MinWidth="0" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="StartupToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="#E0A100" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="設定檔位置" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="ConfigPathText" IsTextSelectionEnabled="True"
                                               Style="{StaticResource SettingDescriptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="開啟資料夾" VerticalAlignment="Center" Click="OpenConfigFolder_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 外觀 -->
                <ScrollViewer x:Name="PageAppearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Padding="0,0,8,8">
                        <TextBlock Text="外觀" Style="{StaticResource SettingSectionStyle}" />
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="#EC4899" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="應用主題" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="跟隨系統，或固定淺色 / 深色" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="ThemeCombo" MinWidth="140" VerticalAlignment="Center"
                                          SelectionChanged="ThemeCombo_SelectionChanged">
                                    <ComboBoxItem Content="淺色晨霧" Tag="Light" />
                                    <ComboBoxItem Content="深色夜幕" Tag="Dark" />
                                    <ComboBoxItem Content="跟隨系統" Tag="System" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE771;" FontSize="18" Foreground="#3B82F6" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="強調色" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="標誌、選取中的分頁、連結與進度條的顏色" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="AccentCombo" MinWidth="140" VerticalAlignment="Center"
                                          SelectionChanged="AccentCombo_SelectionChanged">
                                    <ComboBoxItem Content="晴空藍" Tag="Blue" />
                                    <ComboBoxItem Content="薰衣紫" Tag="Purple" />
                                    <ComboBoxItem Content="森林綠" Tag="Green" />
                                    <ComboBoxItem Content="琥珀橙" Tag="Orange" />
                                    <ComboBoxItem Content="櫻花粉" Tag="Pink" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE7F7;" FontSize="18" Foreground="#14B8A6" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="背景材質" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="亞克力透出模糊桌布；雲母較淡雅；純色最清楚、最省資源" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="BackdropCombo" MinWidth="140" VerticalAlignment="Center"
                                          SelectionChanged="BackdropCombo_SelectionChanged">
                                    <ComboBoxItem Content="亞克力（霧面）" Tag="Acrylic" />
                                    <ComboBoxItem Content="雲母" Tag="Mica" />
                                    <ComboBoxItem Content="純色" Tag="Solid" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <TextBlock Text="透明度" Style="{StaticResource SettingSectionStyle}" />
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE793;" FontSize="18" Foreground="#F59E0B" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="背板" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="PanelTransparencyText" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Slider Grid.Column="2" x:Name="PanelTransparencySlider" Width="200" VerticalAlignment="Center"
                                        Minimum="0" Maximum="100" StepFrequency="1"
                                        ValueChanged="PanelTransparencySlider_ValueChanged" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE8B9;" FontSize="18" Foreground="#38BDF8" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="格子" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="CardTransparencyText" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Slider Grid.Column="2" x:Name="CardTransparencySlider" Width="200" VerticalAlignment="Center"
                                        Minimum="0" Maximum="100" StepFrequency="1"
                                        ValueChanged="CardTransparencySlider_ValueChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 區塊 -->
                <ScrollViewer x:Name="PageBlocks" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Padding="0,0,8,8">
                        <TextBlock Text="側邊欄區塊" Style="{StaticResource SettingSectionStyle}" />
                        <StackPanel x:Name="BlocksHost" Spacing="4" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 桌面：文件格子 + 整理 -->
                <ScrollViewer x:Name="PageDesktop" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Padding="0,0,8,8">
                        <TextBlock Text="文件格子" Style="{StaticResource SettingSectionStyle}" />
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE8DE;" FontSize="18" Foreground="#E0A100" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="拖入收納 / 映射格子時" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="複製會保留來源；移動會讓檔案離開原位置。拖曳時按住 Shift 可臨時切換" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="DropModeCombo" MinWidth="140" VerticalAlignment="Center"
                                          SelectionChanged="DropModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="複製" Tag="Copy" />
                                    <ComboBoxItem Content="移動" Tag="Move" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="#E0A100" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="收納資料夾位置" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="StorageRootText" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="開啟" Click="OpenStorageRoot_Click" />
                                    <Button Content="變更…" Click="ChangeStorageRoot_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE8A7;" FontSize="18" Foreground="#E0A100" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="桌面格子提到最前面" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="BoxesHotkeyStatusText" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <TextBox Grid.Column="2" x:Name="BoxesHotkeyBox" Width="140" VerticalAlignment="Center"
                                         PlaceholderText="Ctrl+Alt+B" LostFocus="BoxesHotkeyBox_LostFocus" />
                                <ToggleSwitch Grid.Column="3" x:Name="BoxesHotkeyToggle" MinWidth="0" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="BoxesHotkeyToggle_Toggled" />
                            </Grid>
                        </Border>

                        <TextBlock Text="桌面整理" Style="{StaticResource SettingSectionStyle}" />
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE8CB;" FontSize="18" Foreground="#0EA5E9" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="一鍵整理桌面" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="OrganizeStatusText" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button x:Name="UndoOrganizeButton" Content="復原上次" Click="UndoOrganize_Click" />
                                    <Button Content="開始整理…" Style="{StaticResource AccentButtonStyle}" Click="OpenOrganizer_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE895;" FontSize="18" Foreground="#0EA5E9" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="自動整理新檔案" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="只處理開啟後才出現在桌面、且符合規則的檔案；等檔案停止變動才移動，拿不準就留在原地" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" x:Name="AutoOrganizeToggle" MinWidth="0" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="AutoOrganizeToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <FontIcon Glyph="&#xE71C;" FontSize="18" Foreground="#0EA5E9" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="分類規則" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="每行一條：名稱: .副檔名 .副檔名。順序越前優先；也用於格子的「依類型叠放」" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="還原預設" Click="ResetRules_Click" />
                                        <Button Content="儲存規則" Click="SaveRules_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="RulesBox" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="130"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="12" Margin="34,0,0,0" />
                                <TextBlock x:Name="RulesStatusText" Margin="34,0,0,0" Style="{StaticResource SettingDescriptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 功能：剪貼簿、搜尋、天氣 -->
                <ScrollViewer x:Name="PageFeatures" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Padding="0,0,8,8">
                        <TextBlock Text="隨記與剪貼簿" Style="{StaticResource SettingSectionStyle}" />
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE77F;" FontSize="18" Foreground="#EC4899" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="記錄剪貼簿" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="在「剪貼簿」分頁保留最近 40 筆複製的文字與檔案，只存在本機" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="清空記錄" VerticalAlignment="Center" Click="ClearClipboard_Click" />
                                <ToggleSwitch Grid.Column="3" x:Name="ClipboardToggle" MinWidth="0" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="ClipboardToggle_Toggled" />
                            </Grid>
                        </Border>

                        <TextBlock Text="搜尋" Style="{StaticResource SettingSectionStyle}" />
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="#6366F1" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="搜尋快捷鍵" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="SearchHotkeyStatusText" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <TextBox Grid.Column="2" x:Name="SearchHotkeyBox" Width="140" VerticalAlignment="Center"
                                         PlaceholderText="Ctrl+Alt+F" LostFocus="SearchHotkeyBox_LostFocus" />
                                <ToggleSwitch Grid.Column="3" x:Name="SearchHotkeyToggle" MinWidth="0" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="SearchHotkeyToggle_Toggled" />
                            </Grid>
                        </Border>

                        <TextBlock Text="天氣" Style="{StaticResource SettingSectionStyle}" />
                        <Border Style="{StaticResource SettingRowStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <FontIcon Glyph="&#xE753;" FontSize="18" Foreground="#3B82F6" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="天氣地區" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock x:Name="CurrentLocationText" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="34,0,0,0">
                                    <TextBox x:Name="CityBox" PlaceholderText="輸入城市名稱，例如：台中、Tokyo"
                                             KeyDown="CityBox_KeyDown" />
                                    <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="SearchCity_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE721;" FontSize="12" />
                                            <TextBlock Text="搜尋" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ListView x:Name="CityResults" MaxHeight="160" Margin="34,0,0,0" SelectionMode="Single"
                                          SelectionChanged="CityResults_SelectionChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 備份 -->
                <ScrollViewer x:Name="PageBackup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Padding="0,0,8,8">
                        <TextBlock Text="備份與維護" Style="{StaticResource SettingSectionStyle}" />
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE8F1;" FontSize="18" Foreground="#22C55E" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="備份 / 還原" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="ZIP 包含設定、格子清單、待辦、隨記與整理記錄；不包含資料夾裡的實際檔案。還原前會自動建立快照" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="匯出…" Click="ExportBackup_Click" />
                                    <Button Content="還原…" Click="ImportBackup_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE81C;" FontSize="18" Foreground="#22C55E" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="自動快照" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="SnapshotStatusText" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="立即建立" Click="CreateSnapshot_Click" />
                                    <Button Content="開啟資料夾" Click="OpenSnapshots_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="BackupStatusText" Margin="4,2,0,0" Style="{StaticResource SettingDescriptionStyle}" />

                        <TextBlock Text="自動更新" Style="{StaticResource SettingSectionStyle}" />
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="#22C55E" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="啟動時檢查 GitHub" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="用安裝包裝過的電腦，開啟 RDesk 就會檢查 Releases 並下載新版；下次啟動套用。不簽章。" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" x:Name="AutoUpdateToggle" MinWidth="0" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="AutoUpdateToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="#22C55E" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="GitHub 專案網址" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="公開 repo，預設 https://github.com/shelan46k/RDesk" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <TextBox Grid.Column="2" x:Name="UpdateGithubBox" MinWidth="280" VerticalAlignment="Center"
                                         PlaceholderText="https://github.com/shelan46k/RDesk"
                                         LostFocus="UpdateGithubBox_LostFocus" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE777;" FontSize="18" Foreground="#22C55E" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="檢查更新" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingDescriptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="立即檢查" Click="CheckUpdate_Click" />
                                    <Button x:Name="RestartUpdateButton" Content="立即重啟並更新" Click="RestartUpdate_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <Grid Grid.Row="2" Padding="28,12,28,20" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="AppVersionFooter" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource DialogSecondaryTextBrush}" />
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" MinWidth="110"
                    Click="Close_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" />
                    <TextBlock Text="完成" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</windowex:WindowEx>
